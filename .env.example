# --- Jira Cloud (Basic Auth: email + API token) ---
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL is server-only: used by JiraClient for the REST API (sync).
# Never expose the API token or the Authorization header to the browser.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=integrations@your-company.com
JIRA_API_TOKEN=your-api-token-here

# Same value as JIRA_BASE_URL, but exposed to the browser so the UI can
# build "Open in Jira" links (e.g. ${NEXT_PUBLIC_JIRA_BASE_URL}/browse/KEY-123).
# Kept separate from JIRA_BASE_URL so accidentally renaming the server-side
# var never leaks the token's host context to the bundle.
NEXT_PUBLIC_JIRA_BASE_URL=https://your-company.atlassian.net

# --- Optional: scope which projects appear on /projects ---
# Comma-separated Jira project keys. If unset or empty, all accessible
# projects are listed.
# Example: JIRA_PROJECT_KEYS=ENG,OPS,CS
JIRA_PROJECT_KEYS=

# --- Supabase (cloud) ---
# Project URL: Supabase dashboard → Project Settings → API → Project URL.
# The subdomain before .supabase.co is the project ref used by `supabase link`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon public key: Project Settings → API → Project API keys → "anon public".
# Safe to ship to the browser; reads are gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role secret: Project Settings → API → Project API keys → "service_role".
# SERVER-ONLY. Never import in a Client Component, never log, never commit a
# real value. Used for sync writes and any code that needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Sync ---
# Shared secret required by POST /api/sync via the x-sync-secret header.
# Generate one with: openssl rand -hex 32
SYNC_SECRET=your-sync-secret-here

# --- Auth (iter 4f) ---
# Comma-separated list of email domains allowed to log in via Google OAuth.
# A user whose email's domain is not on this list gets signed out and
# redirected to /login?error=domain. Server-only; never sent to the browser.
# Example: ALLOWED_EMAIL_DOMAINS=veevart.com,partner.com
ALLOWED_EMAIL_DOMAINS=veevart.com
