# --- Jira Cloud (Basic Auth: email + API token) ---
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=integrations@your-company.com
JIRA_API_TOKEN=your-api-token-here

# --- Optional: scope which projects appear on /projects ---
# Comma-separated Jira project keys. If unset or empty, all accessible
# projects are listed.
# Example: JIRA_PROJECT_KEYS=ENG,OPS,CS
JIRA_PROJECT_KEYS=

# --- Supabase (cloud) ---
# Project URL: Supabase dashboard → Project Settings → API → Project URL.
# The subdomain before .supabase.co is the project ref used by `supabase link`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon public key: Project Settings → API → Project API keys → "anon public".
# Safe to ship to the browser; reads are gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role secret: Project Settings → API → Project API keys → "service_role".
# SERVER-ONLY. Never import in a Client Component, never log, never commit a
# real value. Used for sync writes and any code that needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Sync ---
# Shared secret required by POST /api/sync via the x-sync-secret header.
# Generate one with: openssl rand -hex 32
SYNC_SECRET=your-sync-secret-here
